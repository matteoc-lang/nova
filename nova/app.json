{
  "expo": {
    "name": "NOVA",
    "slug": "nova-jellyfin",
    "version": "1.0.0",
    "scheme": "nova",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],

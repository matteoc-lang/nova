{
  "expo": {
    "name": "NOVA",
    "slug": "nova-jellyfin",
    "version": "1.0.0",
    "scheme": "nova",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "androidStatusBar": {
      "backgroundColor": "#08080b",
      "barStyle": "light-content",
      "translucent": false
    },
    "android": {
      "package": "com.matteo.nova",
      "versionCode": 2,
      "usesCleartextTraffic": true,
      "permissions": ["INTERNET"]
    },
    "plugins": ["expo-secure-store", "expo-screen-orientation"]
  }
}

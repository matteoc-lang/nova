{
  "expo": {
    "name": "NOVA",
    "slug": "nova-jellyfin",
    "version": "1.1.0",
    "scheme": "nova",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08080b",
    "newArchEnabled": true,
    "splash": { "backgroundColor": "#08080b", "resizeMode": "contain" },
    "assetBundlePatterns": ["**/*"],
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#08080b",
      "translucent": true
    },
    "android": {
      "package": "com.matteo.nova",
      "versionCode": 2,
      "usesCleartextTraffic": true,
      "permissions": [
        "INTERNET",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-secure-store",
      ["expo-video", { "supportsBackgroundPlayback": true, "supportsPictureInPicture": true }]
    ]
  }
}

{
  "expo": {
    "name": "NOVA",
    "slug": "nova-jellyfin",
    "version": "1.0.0",
    "scheme": "nova",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.matteo.nova",
      "versionCode": 1,
      "usesCleartextTraffic": true,
      "permissions": [
        "INTERNET",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-secure-store",
      ["expo-video", { "supportsBackgroundPlayback": true, "supportsPictureInPicture": true }]
    ]
  }
}